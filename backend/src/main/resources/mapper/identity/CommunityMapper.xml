<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.elderlycare.platform.identity.mapper.CommunityMapper">
  <select id="lockActiveById" resultType="com.elderlycare.platform.identity.domain.Community">
    SELECT id, name FROM community WHERE id = #{id} AND status = 'ACTIVE' FOR UPDATE
  </select>
  <select id="findActiveById" resultType="com.elderlycare.platform.identity.domain.Community">
    SELECT id, name
    FROM community
    WHERE id = #{id} AND status = 'ACTIVE'
  </select>
</mapper>
