# 复制为同目录 application-local.yml；在 backend 目录手动启用 dev,local 启动。
# 仅供本机合成数据测试；实际配置已被 Git 忽略，不会打包进 JAR。
spring:
  datasource:
    url: 'jdbc:mysql://127.0.0.1:3306/elderly_care?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true'
    username: 'elderly_care'
    password: '' # 填写本机 MySQL 密码。
    driver-class-name: com.mysql.cj.jdbc.Driver

server:
  port: 8080 # 修改后需同步修改前端 Vite 代理端口。

app:
  dev-password: '' # 填写 12～64 位后台登录密码；仅在首次创建 dev.operator 时写入。
  # dev 默认使用公开的合成数据测试密钥；如已有数据使用自定义密钥，请填写原密钥。
  # elder:
  #   encryption-key: '32 个随机字节的 Base64 编码'

# YAML 单引号中的单引号需写成两个单引号，例如 'abc''def'。
# dev 使用进程内会话，当前本地测试无需配置 Redis、RabbitMQ、微信或对象存储。
